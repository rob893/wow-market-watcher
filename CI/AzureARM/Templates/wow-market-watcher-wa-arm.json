{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "appServicePlanName": {
      "type": "string",
      "metadata": {
        "description": "Name of the shared app service plan (lives in the shared resource group)."
      },
      "defaultValue": "rherber-development"
    },
    "sharedResourceGroupName": {
      "type": "string",
      "metadata": {
        "description": "Resource group that holds the shared App Service plan and Log Analytics workspace."
      },
      "defaultValue": "rherber-shared-rg-ue-d"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "metadata": {
        "description": "Shared Log Analytics workspace to link the workspace-based App Insights to."
      },
      "defaultValue": "rherber-logworkspace-uw-lws-d"
    },
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the web app."
      },
      "minLength": 2,
      "defaultValue": "rherber-wow-market-watcher-uw-wa-d"
    },
    "appInsightsName": {
      "type": "string",
      "metadata": {
        "description": "Name of the app insights instance."
      },
      "minLength": 2,
      "defaultValue": "rherber-wow-market-watcher-uw-ai-d"
    },
    "aspnetCoreEnvironment": {
      "type": "string",
      "defaultValue": "Production"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "RetentionInDays": 60,
        "IngestionMode": "LogAnalytics",
        "WorkspaceResourceId": "[resourceId(parameters('sharedResourceGroupName'), 'Microsoft.OperationalInsights/workspaces', parameters('logAnalyticsWorkspaceName'))]"
      },
      "tags": {
        "environment": "[parameters('aspnetCoreEnvironment')]",
        "creator": "Robert Herber"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2018-11-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"
      ],
      "kind": "app",
      "tags": {
        "environment": "[parameters('aspnetCoreEnvironment')]",
        "creator": "Robert Herber"
      },
      "properties": {
        "serverFarmId": "[resourceId(parameters('sharedResourceGroupName'), 'Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "enabled": true,
        "httpsOnly": true,
        "siteConfig": {
          "netFrameworkVersion": "10.0",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "[parameters('aspnetCoreEnvironment')]"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(concat('Microsoft.Insights/components/', parameters('appInsightsName'))).InstrumentationKey]"
            }
          ],
          "ipSecurityRestrictions": [
            {
              "ipAddress": "Any",
              "action": "Allow",
              "priority": 1,
              "name": "Allow all",
              "description": "Allow all access"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2016-09-01",
      "name": "siteLock",
      "scope": "[concat('Microsoft.Web/sites/', parameters('webAppName'))]",
      "dependsOn": ["[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"],
      "properties": {
        "level": "CanNotDelete",
        "notes": "Site should not be deleted."
      }
    },
    {
      "type": "Microsoft.Authorization/locks",
      "apiVersion": "2016-09-01",
      "name": "appInsightsLock",
      "scope": "[concat('Microsoft.Insights/components/', parameters('appInsightsName'))]",
      "dependsOn": ["[resourceId('Microsoft.Insights/components', parameters('appInsightsName'))]"],
      "properties": {
        "level": "CanNotDelete",
        "notes": "App Insights should not be deleted."
      }
    }
  ]
}
